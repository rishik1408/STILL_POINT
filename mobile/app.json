{
  "expo": {
    "name": "STILL POINT",
    "slug": "still-point-piams",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stillpoint",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F4EF",
    "ios": {
      "bundleIdentifier": "com.stillpoint.piams",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.stillpoint.piams",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F6F4EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow STILL POINT to capture photos of public infrastructure defects and completed repairs."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow STILL POINT to tag reported infrastructure defects with accurate GPS coordinates for municipal ward routing."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow STILL POINT to select infrastructure defect photos from your library."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
